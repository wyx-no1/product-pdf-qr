[Unit]
Description=Product PDF QR encrypted read-only backup precopy
Documentation=docs/backup-recovery-pr2a.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/product-pdf-qr
ExecStart=/opt/product-pdf-qr/scripts/backup_recovery/backup-run.sh precopy
TimeoutStartSec=4h
UMask=0077
