[Unit]
Description=Enforce Product PDF QR bounded log retention
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=product-pdf-qr
Group=product-pdf-qr
WorkingDirectory=/opt/product-pdf-qr/current
ExecStart=/opt/product-pdf-qr/current/scripts/production/rotate-logs.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/docker.sock
