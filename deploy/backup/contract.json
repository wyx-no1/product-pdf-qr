{
  "schema_version": 1,
  "business_timezone": "Asia/Shanghai",
  "schedule": {
    "finalizer_local_time": "02:30:00",
    "precopy_local_times": ["06:30:00", "10:30:00", "14:30:00", "18:30:00", "22:30:00"],
    "missed_finalizer": "alert_and_wait_for_next_window",
    "missed_precopy": "run_once_on_boot",
    "week_starts_on": "monday",
    "weekly_generation": "first_verified_backup_on_or_after_monday_02:30",
    "monthly_generation": "first_verified_backup_on_or_after_first_day_02:30"
  },
  "object_model": {
    "kind": "encrypted_content_addressed_objects_with_encrypted_manifest",
    "plaintext_digest": "sha256",
    "object_key_template": "objects/sha256/{digest}/{recipient_key_id}.age",
    "bundle_definition": "one immutable backup_id completion marker referencing one authenticated encrypted manifest",
    "precopy_destination": "remote_encrypted_content_addressed_staging",
    "source_change_detection": "always_sha256_content",
    "max_tmpfs_chunk_bytes": 67108864,
    "complete_marker": "complete/{backup_id}.json"
  },
  "capacity_baseline": {
    "product_count": 5000,
    "database_rows": 1000000,
    "database_dump_bytes": 5368709120,
    "historical_file_count": 20000,
    "historical_file_bytes": 268435456000,
    "daily_new_file_count": 500,
    "daily_new_file_bytes": 5368709120,
    "effective_remote_bandwidth_mbps": 500,
    "remote_round_trip_latency_ms": 50,
    "safety_margin_percent": 25,
    "finalizer_hard_limit_seconds": 900,
    "rto_hard_limit_seconds": 14400,
    "upgrade_thresholds": {
      "daily_new_file_count": 1000,
      "daily_new_file_bytes": 10737418240,
      "database_rows": 2000000,
      "estimated_finalizer_seconds": 720,
      "estimated_restore_seconds": 11520
    }
  },
  "encryption": {
    "tool": "age",
    "version": "1.3.1",
    "format": "age-v1",
    "recipient_type": "X25519",
    "payload_cipher": "ChaCha20-Poly1305",
    "key_derivation": "HKDF-SHA-256",
    "recipient_key_id_required": true,
    "production_private_key_location": "offline_authorized_custodian_only",
    "old_key_retention": "until_every_referenced_daily_weekly_monthly_backup_expires",
    "private_key_injection": "one_time_read_only_secret_to_tmpfs"
  },
  "manifest_authentication": {
    "algorithm": "ed25519",
    "key_bytes": 32,
    "key_id_required": true,
    "backup_signing_authority_location": "production_backup_secret_only",
    "restore_verifier_location": "one_time_restore_public_key_only",
    "retention_verifier_location": "independent_authorized_environment_public_key_only",
    "upload_identity_has_signing_key": false
  },
  "restore_verification_authentication": {
    "algorithm": "ed25519",
    "key_bytes": 32,
    "key_id_required": true,
    "signing_authority_location": "one_time_restore_secret_only",
    "retention_verifier_location": "independent_authorized_environment_public_key_only",
    "backup_upload_identity_has_signing_key": false
  },
  "remote": {
    "category": "S3-compatible object storage",
    "production_fault_domain": {
      "different_host": true,
      "different_account": true,
      "different_region": true,
      "different_storage_lifecycle": true,
      "production_region_example": "ap-east-1",
      "backup_region_example": "ap-southeast-1"
    },
    "versioning_required": true,
    "object_lock_required": true,
    "minimum_object_lock_days": 14,
    "upload_identity_permissions": ["PutObject", "ListBucket", "GetObjectAttributes", "GetObject"],
    "upload_identity_forbidden_permissions": [
      "DeleteObject",
      "DeleteObjectVersion",
      "PutLifecycleConfiguration",
      "PutObjectRetention",
      "BypassGovernanceRetention"
    ],
    "delete_identity_permissions": ["ListBucket", "GetObject", "PutObject", "DeleteObject"],
    "delete_identity_forbidden_permissions": [
      "DeleteObjectVersion",
      "PutLifecycleConfiguration",
      "PutObjectRetention",
      "BypassGovernanceRetention"
    ],
    "delete_identity_location": "independent_authorized_environment_or_storage_lifecycle",
    "publish_rule": "completion_marker_last_after_remote_size_and_ciphertext_sha256_match"
  },
  "retention": {
    "daily_days": 14,
    "weekly_weeks": 8,
    "monthly_months": 6,
    "delete_only_after_all_generations_expire": true,
    "unique_verified_never_delete": true,
    "verified_rule": "remote_download_plus_complete_isolated_restore_only",
    "delete_key_authority": "ed25519_authenticated_manifest_only",
    "deletion_journal_direction": "delete_resume_only_never_completion"
  },
  "database": {
    "major_version": 16,
    "backup_role": "app_backup",
    "existing_database_restore_role": "app_migrate",
    "new_database_bootstrap": "authorized operator initializes PR1 roles then one-time app_migrate restore",
    "restore_superuser_required": false,
    "write_roles_forbidden_during_freeze": ["app_rw", "app_migrate"],
    "allowed_database_network_services": ["db", "backup"]
  },
  "restore": {
    "modes": {
      "existing_fixed_volumes": "retain_site_then_clean_owned_database_and_restore_referenced_files_in_place_without_deleting_extra_files",
      "new_disaster_stack": "initialize_same_stable_contract_in_new_compose_project_then_restore_before_dns_or_proxy_activation"
    },
    "order": [
      "remote_download",
      "authenticated_preflight",
      "stop_proxy",
      "stop_app",
      "encrypted_site_retention",
      "database",
      "files",
      "offline_full_validation",
      "isolated_app_validation",
      "proxy_last",
      "external_readiness"
    ],
    "site_retention_minimum": [
      "database_dump",
      "file_manifest",
      "config_and_image_identity",
      "audit_projection"
    ],
    "production_confirmation_binding": [
      "environment_id",
      "backup_id",
      "operator_id",
      "approved_data_loss_window",
      "authorization_record",
      "expires_at",
      "one_time_challenge"
    ],
    "rto_starts": "authorized_responsible_party_declares_restore",
    "rto_ends": "proxy_external_readiness_after_isolated_functional_validation"
  },
  "recoverable_config_allowlist": [
    "compose.prod.yaml",
    "compose.backup.yaml",
    "deploy/production/nginx/nginx.conf",
    "deploy/production/nginx/templates/site.conf.template",
    "deploy/production/systemd",
    "deploy/backup",
    "scripts/backup_recovery"
  ],
  "secret_references_only": [
    "database_role_passwords",
    "age_private_keys",
    "certificate_private_keys",
    "acme_credentials",
    "remote_upload_credentials",
    "remote_delete_credentials",
    "manifest_signing_private_keys",
    "restore_verification_signing_private_keys"
  ]
}
