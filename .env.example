# LOCAL DEVELOPMENT ONLY. These synthetic credentials must never be reused.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-postgres-only
APP_MIGRATE_PASSWORD=local-migrate-only
APP_RW_PASSWORD=local-runtime-only
APP_BACKUP_PASSWORD=local-backup-only

POSTGRES_DB=product_pdf_qr_dev
POSTGRES_TEST_DB=product_pdf_qr_test
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgresql://app_rw:local-runtime-only@db:5432/product_pdf_qr_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://app_migrate:local-migrate-only@db:5432/product_pdf_qr_dev
BACKUP_DATABASE_URL=postgresql://app_backup:local-backup-only@db:5432/product_pdf_qr_dev
TEST_DATABASE_URL=postgresql://app_rw:local-runtime-only@db:5432/product_pdf_qr_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://app_migrate:local-migrate-only@db:5432/product_pdf_qr_test
TEST_BACKUP_DATABASE_URL=postgresql://app_backup:local-backup-only@db:5432/product_pdf_qr_test

APP_BIND_HOST=127.0.0.1
APP_PORT=8000
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
STORAGE_ROOT=/data/files
PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_PDF_BYTES=52428800
IMPORT_MAX_UPLOAD_BYTES=10485760
IMPORT_MAX_DECOMPRESSED_BYTES=52428800
IMPORT_MAX_COMPRESSION_RATIO=100
IMPORT_PARSE_TIMEOUT_SECONDS=30
IMPORT_PARSE_MEMORY_BYTES=536870912
IMPORT_MAX_ROWS=5000
PDF_VALIDATION_TIMEOUT_SECONDS=5
PDF_VALIDATION_CPU_SECONDS=3
PDF_VALIDATION_MEMORY_BYTES=536870912
PUBLIC_MISS_LIMIT=20
PUBLIC_MISS_WINDOW_SECONDS=600
# Production defaults to Secure cookies. Local loopback HTTP must explicitly disable it.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_BACKOFF_BASE_SECONDS=1
LOGIN_BACKOFF_MAX_SECONDS=60
