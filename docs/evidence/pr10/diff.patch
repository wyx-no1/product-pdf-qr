+
+
+@pytest.mark.parametrize(
+    ("raw", "normalized"),
+    [
+        (" a001_1 ", "A001_1"),
+        ("a", "A"),
+        ("Z" * 64, "Z" * 64),
+        ("abc-123_DEF", "ABC-123_DEF"),
