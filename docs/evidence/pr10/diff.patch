+    assert second.cache_hit
+    assert second.image_bytes == first.image_bytes
+    assert (service.cache_root / "A001.png").read_bytes() == first.image_bytes
+
+
+@pytest.mark.anyio
+async def test_cache_write_failure_returns_memory_image(
+    tmp_path: Path,
