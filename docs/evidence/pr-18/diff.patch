+
+  <script>
+    (() => {
+      "use strict";
+
+      const LIST_PAGE_SIZE = 50;
+      const csrfToken = {{ csrf_token | tojson }};
+      let currentProduct = null;
+      let listOffset = 0;
+      let listHasNext = false;
+      let listRequestSequence = 0;
+
+      const indexView = document.querySelector("#index-view");
+      const detailView = document.querySelector("#detail-view");
+      const detailLoading = document.querySelector("#detail-loading");
+      const missingProduct = document.querySelector("#missing-product");
+      const missingMessage = document.querySelector("#missing-message");
+      const productContent = document.querySelector("#product-content");
+      const createForm = document.querySelector("#create-form");
+      const listControls = document.querySelector("#list-controls");
+      const uploadForm = document.querySelector("#upload-form");
+      const createButton = document.querySelector("#create-button");
+      const uploadButton = document.querySelector("#upload-button");
+      const createFeedback = document.querySelector("#create-feedback");
+      const listFeedback = document.querySelector("#list-feedback");
+      const uploadFeedback = document.querySelector("#upload-feedback");
+      const qrcodeFeedback = document.querySelector("#qrcode-feedback");
+      const qrcodeImage = document.querySelector("#qrcode-image");
+      const emptyList = document.querySelector("#empty-list");
+      const productTable = document.querySelector("#product-table");
+      const productRows = document.querySelector("#product-rows");
+      const productSearch = document.querySelector("#product-search");
+      const pdfStatusFilter = document.querySelector("#pdf-status-filter");
+      const listPagination = document.querySelector("#list-pagination");
+      const previousPage = document.querySelector("#previous-page");
+      const nextPage = document.querySelector("#next-page");
+      const pageIndicator = document.querySelector("#page-indicator");
+
+      function setFeedback(element, message, kind = "success") {
+        element.textContent = message;
+        element.dataset.kind = kind;
+      }
+
+      async function managementFetch(input, init) {
+        const requestInit = {...(init || {})};
+        const method = String(requestInit.method || "GET").toUpperCase();
+        if (!["GET", "HEAD", "OPTIONS"].includes(method)) {
+          const headers = new Headers(requestInit.headers || {});
+          headers.set("X-CSRF-Token", csrfToken);
+          requestInit.headers = headers;
+        }
+        const response = await fetch(input, requestInit);
+        if (
+          response.redirected
+          && (
+            response.url.includes("/admin/login")
+            || response.url.includes("/admin/change-password")
+          )
+        ) {
+          window.location.assign(response.url);
+          throw new Error("管理员会话需要重新验证。");
+        }
+        return response;
+      }
+
+      async function apiErrorMessage(response) {
+        try {
+          const body = await response.json();
+          if (body?.error?.message) {
+            return body.error.message;
+          }
+          if (typeof body?.detail === "string") {
+            return body.detail;
+          }
+        } catch {
+          // A proxy or request-size middleware may return a non-JSON error body.
+        }
+        return `请求失败（HTTP ${response.status}）`;
+      }
+
+      function formatDate(value) {
+        const parsed = new Date(value);
+        return Number.isNaN(parsed.getTime()) ? "—" : parsed.toLocaleString("zh-CN");
+      }
+
+      function productName(product) {
+        return product.name || "未命名（历史数据）";
+      }
+
+      function pdfStatusLabel(status) {
+        return status === "uploaded" ? "已上传" : "未上传";
+      }
+
+      function parseProductId() {
+        const match = window.location.pathname.match(/^\/admin\/products\/(\d+)\/?$/);
+        return match ? Number(match[1]) : null;
+      }
+
+      function showIndex() {
+        currentProduct = null;
+        indexView.hidden = false;
+        detailView.hidden = true;
+        document.title = "产品列表 · 产品 PDF 管理";
+        void loadProducts();
+      }
+
+      function showDetailLoading() {
+        indexView.hidden = true;
+        detailView.hidden = false;
+        detailLoading.hidden = false;
+        missingProduct.hidden = true;
+        productContent.hidden = true;
+        qrcodeImage.hidden = true;
+        qrcodeImage.removeAttribute("src");
+        setFeedback(uploadFeedback, "");
+        setFeedback(qrcodeFeedback, "");
+        document.title = "加载产品详情 · 产品 PDF 管理";
+      }
+
+      function renderProduct(product) {
+        currentProduct = product;
+        detailLoading.hidden = true;
+        missingProduct.hidden = true;
+        productContent.hidden = false;
+        document.title = `${product.code} · 产品详情`;
+
+        document.querySelector("#detail-code").textContent = product.code;
+        document.querySelector("#detail-name").textContent = productName(product);
+        document.querySelector("#detail-token").textContent = product.public_token;
+        document.querySelector("#detail-status").textContent = product.status;
+        document.querySelector("#detail-pdf-status").textContent =
+          pdfStatusLabel(product.pdf_status);
+        document.querySelector("#detail-version").textContent =
+          product.current_version_id ?? "—";
+        document.querySelector("#detail-qrcode-status").textContent =
+          product.qrcode_status === "ready" ? "已生成" : "待生成";
+        document.querySelector("#detail-created-at").textContent =
+          formatDate(product.created_at);
+        document.querySelector("#detail-updated-at").textContent =
+          formatDate(product.updated_at);
+
+        const publicUrl = document.querySelector("#detail-public-url");
+        publicUrl.textContent = product.public_url;
+        publicUrl.href = product.public_url;
+
+        qrcodeImage.hidden = false;
+        qrcodeImage.src = product.qrcode_url;
+        qrcodeImage.alt = `${product.code} 产品公开访问二维码`;
+      }
+
+      function showMissingProduct(message) {
+        currentProduct = null;
+        detailLoading.hidden = true;
+        productContent.hidden = true;
+        missingProduct.hidden = false;
+        missingMessage.textContent = message;
+        document.title = "产品不可用 · 产品 PDF 管理";
+      }
+
+      async function loadProduct(productId) {
+        showDetailLoading();
+        try {
+          const response = await managementFetch(`/api/products/${productId}`);
+          if (response.status === 404) {
+            showMissingProduct("未找到该产品，可能已被移除。");
+            return;
+          }
+          if (!response.ok) {
+            throw new Error(await apiErrorMessage(response));
+          }
+          renderProduct(await response.json());
+        } catch (error) {
+          const message = error instanceof Error ? error.message : "产品详情加载失败。";
+          showMissingProduct(`${message} 请稍后重试或返回产品列表。`);
+        }
+      }
+
+      function appendTextCell(row, value) {
+        const cell = document.createElement("td");
+        cell.textContent = value;
+        row.append(cell);
+        return cell;
+      }
+
+      function hasListFilters() {
+        return productSearch.value.trim() !== "" || pdfStatusFilter.value !== "";
+      }
+
+      function productListUrl() {
+        const parameters = new URLSearchParams({
+          limit: String(LIST_PAGE_SIZE + 1),
+          offset: String(listOffset),
+        });
+        const query = productSearch.value.trim();
+        if (query) {
+          parameters.set("q", query);
+        }
+        if (pdfStatusFilter.value) {
+          parameters.set("pdf_status", pdfStatusFilter.value);
+        }
+        return `/api/products?${parameters.toString()}`;
+      }
+
+      function renderProductList(products) {
+        const pageProducts = products.slice(0, LIST_PAGE_SIZE);
+        listHasNext = products.length > LIST_PAGE_SIZE;
+        productRows.replaceChildren();
+        emptyList.textContent = hasListFilters()
+          ? "没有匹配的产品。请调整或清除搜索条件。"
+          : "暂无产品。请使用上方表单创建第一个产品。";
+        emptyList.hidden = pageProducts.length !== 0;
+        productTable.hidden = pageProducts.length === 0;
+        listPagination.hidden = pageProducts.length === 0;
+        previousPage.disabled = listOffset === 0;
+        nextPage.disabled = !listHasNext;
+        pageIndicator.textContent = `第 ${Math.floor(listOffset / LIST_PAGE_SIZE) + 1} 页`;
+
+        for (const product of pageProducts) {
+          const row = document.createElement("tr");
+          const nameCell = document.createElement("td");
+          const link = document.createElement("a");
+          link.href = `/admin/products/${product.id}`;
+          link.dataset.productLink = "true";
+          link.textContent = productName(product);
+          nameCell.append(link);
+          row.append(nameCell);
+          appendTextCell(row, product.code);
+
+          const statusCell = appendTextCell(row, "");
+          const status = document.createElement("span");
+          status.className = "status";
+          status.dataset.state = product.pdf_status === "uploaded" ? "ready" : "empty";
+          status.textContent = pdfStatusLabel(product.pdf_status);
+          statusCell.append(status);
+          appendTextCell(row, formatDate(product.updated_at));
+          productRows.append(row);
+        }
+      }
+
+      async function loadProducts() {
+        const requestSequence = ++listRequestSequence;
+        setFeedback(listFeedback, "正在加载产品列表…");
+        previousPage.disabled = true;
+        nextPage.disabled = true;
+        try {
+          const response = await managementFetch(productListUrl());
+          if (!response.ok) {
+            throw new Error(await apiErrorMessage(response));
+          }
+          const products = await response.json();
+          if (requestSequence !== listRequestSequence) {
+            return;
+          }
+          renderProductList(products);
+          setFeedback(listFeedback, "");
+        } catch (error) {
+          if (requestSequence !== listRequestSequence) {
+            return;
+          }
+          emptyList.hidden = true;
+          productTable.hidden = true;
+          listPagination.hidden = true;
+          const message = error instanceof Error ? error.message : "产品列表加载失败。";
+          setFeedback(listFeedback, `${message} 请稍后重试。`, "error");
+        }
+      }
+
+      function route() {
+        const productId = parseProductId();
+        if (productId === null) {
+          showIndex();
+          return;
+        }
+        void loadProduct(productId);
+      }
+
+      function navigate(path) {
+        window.history.pushState(null, "", path);
+        route();
+      }
+
+      createForm.addEventListener("submit", async (event) => {
+        event.preventDefault();
+        const formData = new FormData(createForm);
+        const code = String(formData.get("code") ?? "").trim();
+        const name = String(formData.get("name") ?? "").trim();
+
+        createButton.disabled = true;
+        setFeedback(createFeedback, "正在创建…");
+        try {
+          const response = await managementFetch("/api/products", {
+            method: "POST",
+            headers: {"Content-Type": "application/json"},
+            body: JSON.stringify({code, name}),
+          });
+          if (!response.ok) {
+            throw new Error(await apiErrorMessage(response));
+          }
+
+          const created = await response.json();
+          createForm.reset();
+          setFeedback(createFeedback, "");
+          navigate(`/admin/products/${created.id}`);
+        } catch (error) {
+          const message = error instanceof Error ? error.message : "创建失败，请重试。";
+          setFeedback(createFeedback, message, "error");
+        } finally {
+          createButton.disabled = false;
+        }
+      });
+
+      uploadForm.addEventListener("submit", async (event) => {
+        event.preventDefault();
+        if (currentProduct === null) {
+          setFeedback(uploadFeedback, "产品尚未加载完成，请稍后重试。", "error");
+          return;
+        }
+
+        const file = document.querySelector("#pdf-file").files[0];
+        if (!file) {
+          setFeedback(uploadFeedback, "请选择 PDF 文件。", "error");
+          return;
+        }
+
+        const body = new FormData();
+        body.append("file", file);
+        uploadButton.disabled = true;
+        setFeedback(uploadFeedback, "正在上传…");
+        try {
+          const response = await managementFetch(`/api/products/${currentProduct.id}/pdf`, {
+            method: "POST",
+            body,
+          });
+          if (!response.ok) {
+            throw new Error(await apiErrorMessage(response));
+          }
+
+          const uploaded = await response.json();
+          currentProduct.current_version_id = uploaded.version_id;
+          currentProduct.pdf_status = "uploaded";
+          document.querySelector("#detail-pdf-status").textContent = "已上传";
+          document.querySelector("#detail-version").textContent = uploaded.version_id;
+          uploadForm.reset();
+          setFeedback(
+            uploadFeedback,
+            `上传成功：第 ${uploaded.version_no} 版，${uploaded.original_filename}`,
+          );
+        } catch (error) {
+          const message = error instanceof Error ? error.message : "上传失败，请重试。";
+          setFeedback(uploadFeedback, message, "error");
+        } finally {
+          uploadButton.disabled = false;
+        }
+      });
+
+      qrcodeImage.addEventListener("error", () => {
+        qrcodeImage.hidden = true;
+        setFeedback(qrcodeFeedback, "二维码加载失败，请稍后重试。", "error");
+      });
+
+      qrcodeImage.addEventListener("load", () => {
+        qrcodeImage.hidden = false;
+        document.querySelector("#detail-qrcode-status").textContent = "已生成";
+        setFeedback(qrcodeFeedback, "");
+      });
+
+      document.querySelector("#reload-list").addEventListener("click", () => {
+        void loadProducts();
+      });
+
+      listControls.addEventListener("submit", (event) => {
+        event.preventDefault();
+        listOffset = 0;
+        void loadProducts();
+      });
+
+      document.querySelector("#clear-list-filters").addEventListener("click", () => {
+        listControls.reset();
+        listOffset = 0;
+        void loadProducts();
+        productSearch.focus();
+      });
+
+      previousPage.addEventListener("click", () => {
+        listOffset = Math.max(0, listOffset - LIST_PAGE_SIZE);
+        void loadProducts();
+      });
+
+      nextPage.addEventListener("click", () => {
+        if (!listHasNext) {
+          return;
+        }
+        listOffset += LIST_PAGE_SIZE;
+        void loadProducts();
+      });
+
+      productRows.addEventListener("click", (event) => {
+        const link = event.target.closest("[data-product-link]");
+        if (!link) {
+          return;
+        }
+        event.preventDefault();
+        navigate(link.getAttribute("href"));
+      });
+
+      document.querySelectorAll("[data-action='back-to-list']").forEach((link) => {
+        link.addEventListener("click", (event) => {
+          event.preventDefault();
+          navigate("/admin");
+        });
+      });
+
+      window.addEventListener("popstate", route);
+      route();
+    })();
+  </script>
+{% endblock %}
