+    )
+    command = (
+        sys.executable,
+        "-c",
+        (
+            "import os,pathlib,signal,time; "
+            "signal.signal(signal.SIGTERM, signal.SIG_IGN); "
+            f"pathlib.Path({str(pid_file)!r}).write_text(str(os.getpid())); "
+            "time.sleep(30)"
